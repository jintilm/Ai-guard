# ============================================================================
# prompt-ids 环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env（同目录）           cp .env.example .env
#   2. 在 .env 里填 **一个** Key（见下面第一节，21 家任选其一）
#   3. 什么都不用改，导入 prompt_ids 时会自动加载 .env
#
# 注意：
#   - .env 已在 .gitignore 中，不会被提交；**不要把真实 Key 写进本模板文件**
#   - 真实环境变量优先于 .env，CI / 容器里用环境变量覆盖即可
#   - 值不要加引号（加成对引号也能解析，但没必要）；行尾用 " #" 写注释
#   - 也可以指定其它路径：PROMPT_IDS_ENV_FILE=/etc/prompt-ids.env
#
# 不确定填哪个？先跑一条命令看当前环境：
#   prompt-ids --list-providers          # 21 家各自的可用性与该填哪个变量
#   prompt-ids --list-models deepseek    # 向端点查当前真实模型名（模型名会换代）
# ============================================================================


# ---------------------------------------------------------------------------
# 1) LLM 裁判后端（L3 语义层，可选）
#    只有启用 --semantic 且落到 llm 系列后端时才需要 Key。
#    **填一家就够**，自动选型会挑第一个配了 Key 的（顺序见下面的 auto 规则）。
# ---------------------------------------------------------------------------

# >>> 国内推荐：DeepSeek（直连、便宜）<<<
DEEPSEEK_API_KEY=
# >>> 或：阿里云百炼 通义千问 <<<
# DASHSCOPE_API_KEY=
# >>> 或：智谱 GLM（glm-4-flash 有长期免费额度）<<<
# ZHIPUAI_API_KEY=
# >>> 或：月之暗面 Kimi <<<
# MOONSHOT_API_KEY=
# >>> 或：硅基流动 <<<
# SILICONFLOW_API_KEY=
# >>> 或：火山方舟 豆包 <<<
# ARK_API_KEY=
# >>> 或：百度千帆 ERNIE <<<
# QIANFAN_API_KEY=
# >>> 或：MiniMax <<<
# MINIMAX_API_KEY=

# >>> 国际：OpenAI <<<
OPENAI_API_KEY=
# >>> 或：Anthropic Claude（走原生 messages 协议，不是 OpenAI 兼容）<<<
# ANTHROPIC_API_KEY=
# >>> 或：Groq（推理极快、有免费额度，适合当回退兜底）<<<
# GROQ_API_KEY=
# >>> 或：Mistral / Together / OpenRouter / xAI / Perplexity <<<
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=

# >>> Azure OpenAI 需要三项（端点 + 部署名 + 版本；鉴权头是 api-key 不是 Bearer）<<<
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=my-gpt-deployment
# AZURE_OPENAI_API_VERSION=2024-06-01

# >>> 本地推理：免 Key，但要显式指定才会用 <<<
#   ollama 先跑：ollama pull qwen3:8b
#   prompt-ids --semantic --semantic-backend ollama "测试文本"
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# >>> 自建/企业网关（one-api、LiteLLM proxy、vLLM 等）：只需填端点 <<<
# PROMPT_IDS_LLM_BASE_URL=https://your-gateway.internal/v1


# ---- 通用覆盖项（一般不填）-------------------------------------------------
# 设置后会盖过上面所有厂商专属变量
# PROMPT_IDS_LLM_API_KEY=
# PROMPT_IDS_LLM_MODEL=deepseek-v4-flash
# PROMPT_IDS_LLM_BASE_URL=
# PROMPT_IDS_LLM_API_VERSION=
# PROMPT_IDS_LLM_DEPLOYMENT=

# 自定义 User-Agent。**只有**在被 Cloudflare 拦下时才需要填：
#   症状是 403 + `error code: 1010`（浏览器完整性校验），stdlib urllib 的默认 UA
#   （Python-urllib/3.x）会命中这类规则。这是 UA 拦截，不是网络/鉴权问题，
#   所以默认不改 UA，由你显式决定是否冒充浏览器。
# PROMPT_IDS_LLM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# provider：auto | deepseek | openai | ollama | ...（21 家，见 --list-providers）
# 留 auto 时按下面的顺序挑第一个已配 Key 的：
#   deepseek → qwen → zhipu → moonshot → siliconflow → volces → qianfan → minimax
#   → openai → anthropic → azure → groq → mistral → together → openrouter → xai → perplexity
# auto 不会选本地端点（装了 Ollama ≠ Ollama 在跑），要本地就显式写。
# PROMPT_IDS_LLM_PROVIDER=deepseek

# 回退链：主端点失败（5xx/限流/欠费）时顺次尝试，逗号分隔
# PROMPT_IDS_LLM_FALLBACKS=groq/llama-3.3-70b-versatile,xai/grok-4.3


# ---------------------------------------------------------------------------
# 2) 透明代理（prompt-ids-proxy）
# ---------------------------------------------------------------------------

# 上游 LLM 网关。指向本地/自建网关时可以留空
# PROMPT_IDS_UPSTREAM=https://api.deepseek.com/v1

# 代理转发到上游时用的 Key（留空则沿用客户端请求头里的 Authorization）
# PROMPT_IDS_UPSTREAM_KEY=


# ---------------------------------------------------------------------------
# 3) REST 服务（prompt-ids-api）
# ---------------------------------------------------------------------------

# 对外鉴权 Key，留空则不鉴权（只建议本机开发时留空）
# PROMPT_IDS_API_KEY=


# ---------------------------------------------------------------------------
# 4) 规则引擎（可选，一般不用动）
# ---------------------------------------------------------------------------

# re | regex。默认自动：装了 regex 就用，否则退回标准库 re（只是慢些，不会少检）
# PROMPT_IDS_RULE_ENGINE=

# 模型下载走镜像站（huggingface.co 直连不通时必填）
# HF_ENDPOINT=https://hf-mirror.com
# Windows 无 symlink 权限时必开，否则缓存里 config.json 为 0 字节
# HF_HUB_DISABLE_SYMLINKS=1
# Xet 会绕开镜像，也关掉
# HF_HUB_DISABLE_XET=1
