# ============================================================================
# prompt-ids 环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env（同目录）           cp .env.example .env
#   2. 在 .env 里填写 Key（见下面第二节）
#   3. 什么都不用改，导入 prompt_ids 时会自动加载 .env
#
# 注意：
#   - .env 已在 .gitignore 中，不会被提交；**不要把真实 Key 写进本模板文件**
#   - 真实环境变量优先于 .env，CI / 容器里用环境变量覆盖即可
#   - 值不要加引号（加成对引号也能解析，但没必要）；行尾用 " #" 写注释
#   - 也可以指定其它路径：PROMPT_IDS_ENV_FILE=/etc/prompt-ids.env
# ============================================================================


# ---------------------------------------------------------------------------
# 1) LLM 裁判后端（L3 语义层，可选）
#    只有启用 --semantic 且选到 llm / deepseek / openai 后端时才需要
# ---------------------------------------------------------------------------

# >>> 在这里填你的 DeepSeek Key（推荐，国内直连、成本低）<<<
DEEPSEEK_API_KEY=

# 想用 OpenAI 就填这个（二选一）
OPENAI_API_KEY=

# 通用覆盖项：设置了它会盖过上面两个 provider 专属变量
# PROMPT_IDS_LLM_API_KEY=

# provider：auto | deepseek | openai。留 auto 时按"哪个 Key 配了"自动判定
# PROMPT_IDS_LLM_PROVIDER=deepseek

# 覆盖模型与端点（一般不用改，下面是 DeepSeek 的默认值）
# PROMPT_IDS_LLM_MODEL=deepseek-chat
# PROMPT_IDS_LLM_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ---------------------------------------------------------------------------
# 2) 透明代理（prompt-ids-proxy）
# ---------------------------------------------------------------------------

# 上游 LLM 网关。指向本地/自建网关时可以留空
# PROMPT_IDS_UPSTREAM=https://api.deepseek.com/v1

# 代理转发到上游时用的 Key（留空则沿用客户端请求头里的 Authorization）
# PROMPT_IDS_UPSTREAM_KEY=


# ---------------------------------------------------------------------------
# 3) REST 服务（prompt-ids-api）
# ---------------------------------------------------------------------------

# 对外鉴权 Key，留空则不鉴权（只建议本机开发时留空）
# PROMPT_IDS_API_KEY=


# ---------------------------------------------------------------------------
# 4) 规则引擎（可选，一般不用动）
# ---------------------------------------------------------------------------

# re | regex。默认自动：装了 regex 就用，否则退回标准库 re（只是慢些，不会少检）
# PROMPT_IDS_RULE_ENGINE=

# 模型下载走镜像站（huggingface.co 直连不通时必填）
# HF_ENDPOINT=https://hf-mirror.com
# Windows 无 symlink 权限时必开，否则缓存里 config.json 为 0 字节
# HF_HUB_DISABLE_SYMLINKS=1
# Xet 会绕开镜像，也关掉
# HF_HUB_DISABLE_XET=1
