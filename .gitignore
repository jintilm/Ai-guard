# 本地凭据与环境配置 —— 不要提交（模板见 .env.example）
.env
prompt_ids.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# 回归测试：本机保留、不随仓库发布。
# 历史：tests/ 曾被误列导致全部单测不在版本库内，后恢复跟踪；
# 2026-11-09 再次改为不跟踪（本地文件保留，仍可用 pytest 跑）。
# ⚠ 代价：CI 与克隆仓库的人拿不到回归测试，改动只能靠本机全量 pytest 验证。
tests/

# 工作笔记与评测缓存（本机状态，不入库）
.workbuddy

# 内部工程记忆（**刻意不随公开仓库发布**）：含本机绝对路径、
# 未验证的临时脚本位置与只对本机有意义的状态。
# 对外可引用的方法学与实测数字已写进 README.md 与 README_Pr.md；
# 引用纪律的公开版本见 README「引用纪律」一节。
AGENTS.md

# 运行期产物（审计日志等）
logs/
# 复核语料含原文，刻意不入库（审计层只存指纹，队列只给指纹）
data/review_corpus.jsonl
data/review_mined.jsonl

# 训练产物：可由 `python scripts/train_lightweight.py` 重建，且它的
# TF-IDF 词表**派生自评测语料** —— 入库等于把语料统计第二次带进仓库；
# 而 README 引用的数字又会与入库的二进制产生漂移（陈旧模型 vs 新数字）。
*.joblib
models/

# 编辑器 / 操作系统 / 临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
*.log
*.tmp
*.bak
