# 本地凭据与环境配置 —— 不要提交（模板见 .env.example）
.env
prompt_ids.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# 工作笔记与评测缓存（本机状态，不入库）
# 注意：tests/ 曾被误列在这里，导致全部单测不在版本库内 ——
# 回归测试是本项目唯一的改动安全网，缺了它任何重构都不可验证。已移除该行。
.workbuddy

# 运行期产物（审计日志等）
logs/
# 复核语料含原文，刻意不入库（审计层只存指纹，队列只给指纹）
data/review_corpus.jsonl
data/review_mined.jsonl

# 训练产物：可由 `python scripts/train_lightweight.py` 重建，且它的
# TF-IDF 词表**派生自评测语料** —— 入库等于把语料统计第二次带进仓库；
# 而 README 引用的数字又会与入库的二进制产生漂移（陈旧模型 vs 新数字）。
*.joblib
models/

# 编辑器 / 操作系统 / 临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
*.log
*.tmp
*.bak
